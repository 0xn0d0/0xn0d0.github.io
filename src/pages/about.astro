---
import Layout from '../layouts/Layout.astro';
---

<Layout title="> about | cyber portfolio">
  <header>
    <nav>
      <div class="logo">root@cyber</div>
      <ul class="nav-links">
        <li><a href="/">home</a></li>
        <li><a href="/about">about</a></li>
        <li><a href="/blog">blog</a></li>
        <li><a href="/contact">contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="section">
      <div class="container">
        <div class="terminal-window">
          <div class="terminal-header">
            <span class="terminal-title">whoami.sh</span>
          </div>
          <div class="terminal-body">
            <div class="output-line">
              <span class="prompt">root@cyber</span>:<span class="prompt-path">~</span>$ 
              <span class="info">cat</span> about.md
            </div>
            <div style="margin-top: 20px; line-height: 1.8;">
              <p class="success" style="font-size: 1.5rem; margin-bottom: 15px;">
                # Security Researcher & Penetration Tester
              </p>
              <p style="margin-bottom: 15px;">
                <span class="comment">## About</span>
              </p>
              <p style="color: var(--text-secondary); margin-bottom: 20px;">
                I'm a passionate cybersecurity professional with expertise in penetration testing, 
                vulnerability research, and security architecture. I believe in making the digital 
                world a safer place through responsible disclosure and education.
              </p>
              <p style="color: var(--text-secondary); margin-bottom: 20px;">
                When I'm not hunting bugs or breaking into systems (ethically), you can find me 
                participating in CTF competitions, contributing to open-source security tools, 
                or teaching others about cybersecurity.
              </p>
            </div>
          </div>
        </div>

        <div class="terminal-window" style="margin-top: 30px;">
          <div class="terminal-header">
            <span class="terminal-btn close"></span>
            <span class="terminal-btn minimize"></span>
            <span class="terminal-btn maximize"></span>
            <span class="terminal-title">skills.sh</span>
          </div>
          <div class="terminal-body">
            <div class="output-line">
              <span class="prompt">$</span> ./show_skills.py
            </div>
            <div class="skills-grid">
              <div class="skill-card">
                <div class="skill-name">Penetration Testing</div>
                <div class="skill-bar"><div class="skill-progress" style="width: 95%;"></div></div>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 10px;">
                  Web, Network, Mobile, API Security
                </p>
              </div>
              <div class="skill-card">
                <div class="skill-name">Bug Bounty</div>
                <div class="skill-bar"><div class="skill-progress" style="width: 90%;"></div></div>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 10px;">
                  CVEs, Responsible Disclosure
                </p>
              </div>
              <div class="skill-card">
                <div class="skill-name">Reverse Engineering</div>
                <div class="skill-bar"><div class="skill-progress" style="width: 85%;"></div></div>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 10px;">
                  IDA, Ghidra, Binary Analysis
                </p>
              </div>
              <div class="skill-card">
                <div class="skill-name">CTF Competitions</div>
                <div class="skill-bar"><div class="skill-progress" style="width: 88%;"></div></div>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 10px;">
                  Pwn, RE, Web, Crypto, Forensics
                </p>
              </div>
              <div class="skill-card">
                <div class="skill-name">Python/Scripting</div>
                <div class="skill-bar"><div class="skill-progress" style="width: 92%;"></div></div>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 10px;">
                  Automation, Exploits, Tools
                </p>
              </div>
              <div class="skill-card">
                <div class="skill-name">Cloud Security</div>
                <div class="skill-bar"><div class="skill-progress" style="width: 80%;"></div></div>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 10px;">
                  AWS, GCP, Azure Security
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="terminal-window" style="margin-top: 30px;">
          <div class="terminal-header">
            <span class="terminal-btn close"></span>
            <span class="terminal-btn minimize"></span>
            <span class="terminal-btn maximize"></span>
            <span class="terminal-title">tools.sh</span>
          </div>
          <div class="terminal-body">
            <div class="output-line">
              <span class="prompt">$</span> cat tools.txt | grep -E "favorite|essential"
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-top: 20px;">
              <div style="color: var(--accent-cyan);">▸ Burp Suite</div>
              <div style="color: var(--accent-cyan);">▸ Nmap</div>
              <div style="color: var(--accent-cyan);">▸ Metasploit</div>
              <div style="color: var(--accent-cyan);">▸ SQLMap</div>
              <div style="color: var(--accent-cyan);">▸ Hydra</div>
              <div style="color: var(--accent-cyan);">▸ Gobuster</div>
              <div style="color: var(--accent-cyan);">▸ wfuzz</div>
              <div style="color: var(--accent-cyan);">▸ Hashcat</div>
              <div style="color: var(--accent-cyan);">▸ John</div>
              <div style="color: var(--accent-cyan);">▸ Ghidra</div>
              <div style="color: var(--accent-cyan);">▸ IDA Pro</div>
              <div style="color: var(--accent-cyan);">▸ Wireshark</div>
            </div>
          </div>
        </div>

        <div class="terminal-output" style="margin-top: 30px;">
          <div class="output-line">
            <span class="prompt">$</span> cat certifications.txt
          </div>
          <div style="margin-top: 15px;">
            <p class="success">[+] OSCP - Offensive Security Certified Professional</p>
            <p class="success">[+] CEH - Certified Ethical Hacker</p>
            <p class="success">[+] eWPT - eLearnSecurity Web Penetration Tester</p>
            <p class="success">[+] GPEN - GIAC Penetration Tester</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p style="color: var(--text-secondary); font-size: 0.85rem;">
        <span class="prompt">$</span> <span class="cursor"></span>
      </p>
    </div>
  </footer>
</Layout>
